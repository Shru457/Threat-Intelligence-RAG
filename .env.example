# Environment Configuration Example for Threat Intelligence RAG System
# Copy this file to .env and configure as needed:
#   copy .env.example .env

# LLM Provider selection:
# Options: "offline", "ollama", "gemini", "groq", "openai"
# Default: "offline" (Extractive deterministic synthesis, no external API keys required)
LLM_PROVIDER=offline

# Environment mode: development / testing / production
ENVIRONMENT=development

# Google Gemini API Key (Required only if LLM_PROVIDER=gemini)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Configuration (Required only if LLM_PROVIDER=ollama)
# Ensure Ollama daemon is running locally (e.g., `ollama serve`)
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA model name (e.g., llama3, mistral, llama3:8b)
# LLM_MODEL=llama3:8b

# OpenAI / Groq / OpenRouter API Key (Required only if LLM_PROVIDER=openai or groq)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
LLM_API_KEY=your_generic_api_key_here
